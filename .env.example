# VulnLedger Environment Configuration

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
RUST_LOG=info,vulnledger=debug

# Storage (local or s3)
STORAGE_BACKEND=local
STORAGE_PATH=./storage/data

# Database (Postgres or SQLite for dev)
DATABASE_URL=postgres://vulnledger:vulnledger_dev_pass@localhost:5432/vulnledger
# Or for zero-setup local dev/testing:
# DATABASE_URL=sqlite://vulnledger.db?mode=rwc

# Security
JWT_SECRET=dev_insecure_jwt_secret_must_change_in_production_32bytes_min
SESSION_EXPIRY_HOURS=24

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# CLI Configuration
VULNLEDGER_API_URL=http://localhost:8080/api/v1
VULNLEDGER_API_TOKEN=
